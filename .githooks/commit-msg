#!/bin/sh
set -eu

message_file=$1

# Git-generated merge commits do not represent an independently authored
# product change and inherit provenance from their parents.
case "$(basename "$message_file")" in
  MERGE_MSG) exit 0 ;;
esac

repo_root=$(git rev-parse --show-toplevel)
node "$repo_root/scripts/validate-commit-provenance.mjs" \
  --message-file "$message_file" --staged --check-hook-mode

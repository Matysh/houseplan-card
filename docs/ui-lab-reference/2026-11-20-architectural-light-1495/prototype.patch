diff --git a/src/iso-architectural-tone-lab.ts b/src/iso-architectural-tone-lab.ts
new file mode 100644
index 000000000..e8a802866
--- /dev/null
+++ b/src/iso-architectural-tone-lab.ts
@@ -0,0 +1,31 @@
+/** Local #1495 visual experiment. Presentation only; never persisted. */
+import { colorLuma, parseCssColor, type Rgb } from './iso-materials';
+
+export function architecturalOptions() {
+  return (globalThis as typeof globalThis & { __hp1495?: { enabled: boolean; edges: boolean; strength: number } }).__hp1495
+    ?? { enabled: true, edges: true, strength: 1 };
+}
+const hex = (c: readonly number[]) => '#' + c.map(v => Math.round(Math.max(0, Math.min(255,v))).toString(16).padStart(2,'0')).join('');
+const mix = (c: Rgb, target: number, amount: number) => hex(c.map(v => v + (target-v)*amount));
+
+export function architecturalWallTone(color: string, light: number): string {
+  const rgb=parseCssColor(color), options=architecturalOptions();
+  if (!rgb || !options.enabled) return color;
+  const luma=colorLuma(rgb), t=Math.max(0,Math.min(1,light));
+  // White still has a shadow face; near-black still has a lit face.
+  const darkBlend=Math.max(0,Math.min(1,(.35-luma)/.25));
+  const shadow=.16*(1-t)+.015*t;
+  const lift=.015*(1-t)+.11*t;
+  return hex(rgb.map(v => v*(1-shadow*options.strength*(1-darkBlend))
+    +(255-v)*lift*options.strength*darkBlend));
+}
+
+export function architecturalFloorTone(color: string, wall: string, staticFill: boolean): string {
+  const options=architecturalOptions(), rgb=parseCssColor(color), other=parseCssColor(wall);
+  if (!options.enabled || !staticFill || !rgb || !other) return color;
+  const distance=Math.hypot(...rgb.map((v,i)=>v-other[i]));
+  const similarity=Math.max(0,1-distance/75);
+  if (!similarity) return color;
+  const luma=colorLuma(rgb), k=similarity*options.strength;
+  return luma<.3 ? mix(rgb,255,.055*k) : mix(rgb,0,.065*k);
+}
diff --git a/src/iso-architectural-edges-lab.ts b/src/iso-architectural-edges-lab.ts
new file mode 100644
index 000000000..6db26cb1b
--- /dev/null
+++ b/src/iso-architectural-edges-lab.ts
@@ -0,0 +1,77 @@
+/** #1495 prototype: use existing visible faces, never invent hidden silhouettes. */
+import { nothing, svg, type TemplateResult } from 'lit';
+import { colorLuma, parseCssColor } from './iso-materials';
+import { architecturalOptions, architecturalWallTone } from './iso-architectural-tone-lab';
+import { isoRotationBasis, projectPlanPoint, type IsoCamera, type PlanPoint } from './iso-projection';
+import type { IsoWallDepthQueueEntry } from './iso-scene-geometry';
+
+type Face = { index:number; a:PlanPoint; b:PlanPoint; low:number; high:number; d:string; nx:number; ny:number; color:string };
+type Paint = { fill:(index:number)=>string; edges:TemplateResult|typeof nothing };
+const memo=new WeakMap<object,{key:string;paint:Paint}>();
+const epsilon=1e-4;
+const same=(a:PlanPoint,b:PlanPoint)=>Math.hypot(a[0]-b[0],a[1]-b[1])<epsilon;
+function faceOf(entry:IsoWallDepthQueueEntry,index:number,camera:IsoCamera,color:string):Face|null {
+  let edge:readonly [PlanPoint,PlanPoint]|undefined, low=0, high=0, d='';
+  if(entry.layer==='wall-side') {
+    if(entry.face.roundColumn!==undefined)return null;
+    edge=entry.face.planEdge; high=entry.face.height??0; d=entry.face.d;
+  } else if(entry.layer==='opening' && entry.surface.material==='wall-side') {
+    const points=entry.surface.points;
+    if(!points?.length)return null;
+    low=Math.min(...points.map(p=>p.z)); high=Math.max(...points.map(p=>p.z));
+    const ends:PlanPoint[]=[];
+    for(const p of points)if(!ends.some(q=>same(q,p.point)))ends.push(p.point);
+    if(ends.length!==2)return null;
+    edge=[ends[0],ends[1]]; d=entry.surface.d;
+  }
+  if(!edge || high-low<epsilon || !d)return null;
+  const [a,b]=edge, length=Math.hypot(b[0]-a[0],b[1]-a[1]);
+  if(length<epsilon)return null;
+  let nx=(b[1]-a[1])/length, ny=-(b[0]-a[0])/length;
+  const [cos,sin]=isoRotationBasis(camera);
+  if(nx*sin+ny*cos<0){nx=-nx;ny=-ny;}
+  const sx=nx*cos-ny*sin, sy=nx*sin+ny*cos;
+  const light=(1+(-.8*sx+.6*sy))/2;
+  return {index,a,b,low,high,d,nx,ny,color:architecturalWallTone(color,light)};
+}
+
+export function architecturalPainter(queue:readonly IsoWallDepthQueueEntry[],camera:IsoCamera,color:string):Paint {
+  const options=architecturalOptions();
+  if(!options.enabled)return {fill:()=>'',edges:nothing};
+  const memoKey=JSON.stringify([camera,color,options]);
+  const existing=memo.get(queue);
+  if(existing?.key===memoKey)return existing.paint;
+  const faces=queue.flatMap((entry,i)=>{const f=faceOf(entry,i,camera,color);return f?[f]:[];});
+  const colors=new Map(faces.map(f=>[f.index,`fill:${f.color}`]));
+  const byEnd=new Map<string,Face[]>();
+  const key=(p:PlanPoint)=>p.map(v=>v.toFixed(3)).join(',');
+  for(const face of faces)for(const point of [face.a,face.b]){const k=key(point);byEnd.set(k,[...(byEnd.get(k)??[]),face]);}
+  const seen=new Set<string>();
+  const edges=!options.edges?nothing:svg`<g data-hp="architectural-edges">${faces.map(face=>{
+    const segments:{a:PlanPoint;b:PlanPoint;z1:number;z2:number}[]=[];
+    if(face.low<epsilon)segments.push({a:face.a,b:face.b,z1:0,z2:0});
+    for(const point of [face.a,face.b]) {
+      let intervals=[[face.low,face.high]];
+      for(const other of byEnd.get(key(point))??[]) {
+        if(other===face || Math.abs(face.nx*other.ny-face.ny*other.nx)>epsilon)continue;
+        // Remove shared coplanar construction seams, including apron/lintel joins.
+        intervals=intervals.flatMap(([a,b])=>other.high<=a+epsilon||other.low>=b-epsilon?[[a,b]]:
+          [[a,Math.min(b,other.low)],[Math.max(a,other.high),b]].filter(([l,h])=>h-l>epsilon));
+      }
+      for(const [z1,z2] of intervals) {
+        const id=key(point)+':'+z1.toFixed(3)+':'+z2.toFixed(3);
+        if(!seen.has(id)){seen.add(id);segments.push({a:point,b:point,z1,z2});}
+      }
+    }
+    if(!segments.length)return nothing;
+    const id='hp-arch-edge-'+face.index;
+    const ink=colorLuma(parseCssColor(face.color)??[255,255,255])<.35?'#e2eaf3':'#26313e';
+    const d=segments.map(s=>`M ${projectPlanPoint(s.a,s.z1,camera).join(' ')} L ${projectPlanPoint(s.b,s.z2,camera).join(' ')}`).join(' ');
+    return svg`<defs><clipPath id=${id}><path d=${face.d} fill-rule="evenodd" clip-rule="evenodd"></path></clipPath></defs>
+      <path d=${d} clip-path=${'url(#'+id+')'} fill="none" stroke=${ink} stroke-opacity=".36"
+        style="stroke-width:calc(1.2 * var(--hp-raster-outline-scale, 1))" vector-effect="non-scaling-stroke" stroke-linecap="butt"></path>`;
+  })}</g>`;
+  const paint:Paint={fill:(index:number)=>colors.get(index)??'',edges};
+  memo.set(queue,{key:memoKey,paint});
+  return paint;
+}

diff --git a/demo/ui-lab/session-storage.mjs b/demo/ui-lab/session-storage.mjs
new file mode 100644
index 000000000..48e6f0076
--- /dev/null
+++ b/demo/ui-lab/session-storage.mjs
@@ -0,0 +1,58 @@
+// Local UI Lab storage only. Large snapshots do not share localStorage's small
+// quota with old builds. Legacy records remain untouched as recovery copies.
+import { parseSession, serializeSession, sessionKey } from './session.mjs';
+
+let database;
+let writes = Promise.resolve();
+function openDatabase() {
+  if (!database) database = new Promise((resolve, reject) => {
+    const request = indexedDB.open('houseplan-ui-lab', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('sessions');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => { database = undefined; reject(request.error); };
+    request.onblocked = () => reject(Error('Закройте другие вкладки UI Lab и повторите сохранение'));
+  });
+  return database;
+}
+
+async function transaction(mode, action) {
+  const db = await openDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('sessions', mode);
+    const request = action(tx.objectStore('sessions'));
+    // A request succeeding is not proof that the transaction committed.
+    tx.oncomplete = () => resolve(request.result);
+    tx.onabort = () => reject(tx.error || Error('Сохранение локальной сессии прервано'));
+    tx.onerror = () => {}; // onabort supplies the final failure.
+  });
+}
+
+// undefined = never saved, null = explicitly reset. A tombstone prevents an
+// old localStorage snapshot from returning after the user resets this lab.
+export async function readStoredSession(identity) {
+  await writes;
+  const key = sessionKey(identity);
+  const stored = await transaction('readonly', store => store.get(key));
+  return stored === undefined ? localStorage.getItem(key) ?? undefined : stored;
+}
+
+export async function loadBrowserSession(identity) {
+  const text = await readStoredSession(identity);
+  return text == null ? null : parseSession(text, identity);
+}
+
+function write(identity, text) {
+  const key = sessionKey(identity);
+  const pending = writes.then(() => transaction('readwrite', store => store.put(text, key)));
+  writes = pending.catch(() => {}); // One failed save must not block retries.
+  return pending;
+}
+
+export function saveBrowserSession(identity, snapshot) {
+  // Capture and validate at invocation, before another edit can mutate input.
+  return write(identity, serializeSession(identity, snapshot));
+}
+
+export function resetBrowserSession(identity) {
+  return write(identity, null);
+}

  "inputConstructor": "export function corpus(roomCount=400,partitionCount=2000){\n const rooms=[],wall_segments=[],partitions=[];\n for(let i=0;i<roomCount;i++){\n  const x=(i%20)*12,y=Math.floor(i/20)*12,points=[];\n  for(let j=0;j<5;j++)points.push([x+j,y]);\n  for(let j=0;j<5;j++)points.push([x+5,y+j]);\n  for(let j=0;j<5;j++)points.push([x+5-j,y+5]);\n  for(let j=0;j<5;j++)points.push([x,y+5-j]);\n  const poly=points.map(p=>p.map(n=>n/240)),wall_ids=[];\n  for(let j=0;j<poly.length;j++){const id=`w${String(i).padStart(3,'0')}_${String(j).padStart(2,'0')}`;wall_ids.push(id);wall_segments.push({id,a:poly[j],b:poly[(j+1)%poly.length],cm:15});}\n  rooms.push({id:'r'+i,name:'Synthetic '+i,poly,wall_ids});\n }\n for(let i=0;i<partitionCount;i++){const x=(i%100)*4,y=-20-Math.floor(i/100)*4;partitions.push({id:'p'+String(i).padStart(4,'0'),a:[x/240,y/240],b:[(x+2)/240,y/240],cm:10});}\n return {id:'synthetic-large',title:'Public synthetic benchmark',cell_cm:5,rooms,wall_segments,partitions,openings:[]};\n}\n",
  "corpusSha256": "f7f0cc155465859c2a8a5ca31a7c71794f3041466f7953eb6b60f25fc5ceb580",

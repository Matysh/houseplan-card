diff --git a/tests/lib/preview-observer.mjs b/tests/lib/preview-observer.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b806e08d01004365339948c47d9b5bbaa6f022d0
--- /dev/null
+++ b/tests/lib/preview-observer.mjs
@@ -0,0 +1,54 @@
+/** Reporter-only capture of the real browser HTTP reply to a large import.
+ * Chromium's default inspector cache can evict a reply when its POST is >32MiB.
+ * A separate bounded Network observer keeps the actual bytes; it never routes,
+ * repeats, mocks, fulfils or changes the product request/response. */
+export async function observeLargePreview(page, { timeout = 30_000 } = {}) {
+  const session = await page.context().newCDPSession(page);
+  try {
+    await session.send('Network.enable', { maxTotalBufferSize: 128 * 1024 * 1024,
+      maxResourceBufferSize: 64 * 1024 * 1024, maxPostDataSize: 0 });
+  } catch (error) { await session.detach(); throw error; }
+  const requests = [], preview = url => /^\/api\/houseplan\/(?:backup\/)?import\/preview$/.test(new URL(url).pathname);
+  let resolve, reject, selected, finished = false, disposed = false;
+  const response = new Promise((yes, no) => { resolve = yes; reject = no; });
+  // The caller waits after native UI interaction; retain an early failure
+  // without an unhandled rejection, while the original promise stays failed.
+  response.catch(() => {});
+  const fail = error => { if (!finished) { finished = true; reject(error); } };
+  const timer = setTimeout(() => fail(Error('The real large-preview reply was not captured before timeout')), timeout);
+  const onRequest = event => {
+    if (event.request.method !== 'POST' || !preview(event.request.url)) return;
+    requests.push({ requestId: event.requestId, url: event.request.url, method: event.request.method });
+    if (requests.length !== 1) fail(Error('More than one real preview POST was observed'));
+  };
+  const onResponse = event => {
+    if (!requests.some(request => request.requestId === event.requestId)) return;
+    if (!preview(event.response.url) || selected) return fail(Error('Ambiguous large-preview response'));
+    selected = { ...requests[0], status: event.response.status };
+  };
+  const onFailed = event => {
+    if (requests.some(request => request.requestId === event.requestId)) fail(Error(`Large-preview HTTP failed: ${event.errorText}`));
+  };
+  const onFinished = async event => {
+    if (!selected || event.requestId !== selected.requestId || finished) return;
+    try {
+      const body = await session.send('Network.getResponseBody', { requestId: event.requestId });
+      const reply = JSON.parse(body.base64Encoded ? Buffer.from(body.body, 'base64').toString('utf8') : body.body);
+      if (requests.length !== 1) throw Error('Large-preview request identity changed');
+      finished = true; clearTimeout(timer); resolve({ ...selected, reply });
+    } catch (error) { fail(error); }
+  };
+  session.on('Network.requestWillBeSent', onRequest);
+  session.on('Network.responseReceived', onResponse);
+  session.on('Network.loadingFailed', onFailed);
+  session.on('Network.loadingFinished', onFinished);
+  return { response, requests,
+    async dispose() {
+      if (disposed) return; disposed = true; clearTimeout(timer);
+      fail(Error('Large-preview observation disposed before completion'));
+      session.off('Network.requestWillBeSent', onRequest); session.off('Network.responseReceived', onResponse);
+      session.off('Network.loadingFailed', onFailed); session.off('Network.loadingFinished', onFinished);
+      await session.detach();
+    },
+  };
+}
diff --git a/tests/lib/profile-fixtures.mjs b/tests/lib/profile-fixtures.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..42a0a5d02e1391ea4e1cf60a6affb236b2c12981
--- /dev/null
+++ b/tests/lib/profile-fixtures.mjs
@@ -0,0 +1,18 @@
+/** Wire fixtures, not a runtime resolver: keep legacy rows explicit. */
+export const legacyScreenDefaults = id => ({ id, space: null, rotation: 0, cycle: 0, idle: 0,
+  summary: 'local', hidden_devices: 'local', icon_scale: null, font_scale: null, controls: true });
+export const viewDefaults = () => ({ rotation: 0, zoom: 1, summary: 'local', center_summary: false,
+  icon_scale: null, font_scale: null });
+export const screenDefaults = (id, version = 2) => version === 1 ? legacyScreenDefaults(id)
+  : { id, space: null, cycle: 0, idle: 0, default_view: viewDefaults(), space_views: {} };
+export function currentProfile(row) {
+  if (row.default_view) return structuredClone(row);
+  const { rotation, summary, icon_scale, font_scale, hidden_devices, controls, ...rest } = row;
+  return { ...rest, default_view: { ...viewDefaults(), rotation, summary, icon_scale, font_scale }, space_views: {} };
+}
+export const profileNamespace = config => config.settings?.external_screens;
+export const profileOf = (config, id) => profileNamespace(config)?.screens.find(row => row.id === id);
+export function profileView(config, id, space) {
+  const row = profileOf(config, id);
+  return row?.default_view ? row.space_views[space] ?? row.default_view : row;
+}
diff --git a/tests/lib/visible-plan-target.mjs b/tests/lib/visible-plan-target.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..23e58b846bd96ed31c199b4d167805ae5a2b4487
--- /dev/null
+++ b/tests/lib/visible-plan-target.mjs
@@ -0,0 +1,58 @@
+/** Browser-side geometry only: a visible, unobscured snapped native edit target.
+ * Never changes camera/product state and never reaches private product fields. */
+export function visiblePlanSegment(svg, { step, pixels = 90, clearInterior = false, pattern = [[[0, 0], [1, 0]]] }) {
+  if (!(step > 0)) throw Error('The editor must expose a positive grid step');
+  const matrix = svg.getScreenCTM(), box = svg.getBoundingClientRect();
+  if (!matrix || ![matrix.a, matrix.b, matrix.c, matrix.d, matrix.e, matrix.f].every(Number.isFinite)
+      || matrix.a * matrix.d - matrix.b * matrix.c === 0) throw Error('The visible stage has no invertible floor transform');
+  const inverse = matrix.inverse(), scale = Math.hypot(matrix.a, matrix.b);
+  if (!(scale > 0)) throw Error('The visible stage has no positive scale');
+  const clip = { left: Math.max(0, box.left) + 32, top: Math.max(0, box.top) + 32,
+    right: Math.min(innerWidth, box.right) - 32, bottom: Math.min(innerHeight, box.bottom) - 32 };
+  // First migration uses free canvas, not a cut across an existing room or a
+  // magnet close to one of its walls. Conservative DOM boxes are sufficient:
+  // failing to find free room is explicit, never permission to change the seed.
+  const occupied = [...svg.querySelectorAll('[data-hp="room"],[data-hp="wall"],[data-hp="device"]')]
+    .map(node => node.getBoundingClientRect()).filter(rect => rect.width > 0 && rect.height > 0);
+  const client = p => { const q = new DOMPoint(p.x, p.y).matrixTransform(matrix); return { x: q.x, y: q.y }; };
+  const available = p => {
+    if (p.x < clip.left || p.x > clip.right || p.y < clip.top || p.y > clip.bottom) return false;
+    if (occupied.some(rect => p.x >= rect.left - 12 && p.x <= rect.right + 12
+      && p.y >= rect.top - 12 && p.y <= rect.bottom + 12)) return false;
+    let hit = svg.ownerDocument.elementFromPoint(p.x, p.y);
+    while (hit?.shadowRoot) {
+      const next = hit.shadowRoot.elementFromPoint(p.x, p.y);
+      if (!next || next === hit) break;
+      hit = next;
+    }
+    return !!hit && (hit === svg || svg.contains(hit)) && !hit.closest(
+      'button,input,select,[data-hp="device"],[data-hp="wall-node"],[data-hp="wall"],[data-hp="opening"]');
+  };
+  const cells = Math.max(1, Math.ceil(pixels / (step * scale)));
+  for (const fy of [.35, .5, .65, .2, .8]) for (const fx of [.2, .35, .5, .65, .8]) {
+    const point = new DOMPoint(clip.left + (clip.right - clip.left) * fx,
+      clip.top + (clip.bottom - clip.top) * fy).matrixTransform(inverse);
+    const a = { x: Math.round(point.x / step) * step, y: Math.round(point.y / step) * step };
+    for (const axis of ['x', 'y']) {
+      const pointAt = ([x, y]) => ({ x: a.x + (axis === 'x' ? x : y) * cells * step,
+        y: a.y + (axis === 'x' ? y : x) * cells * step });
+      const segments = pattern.map(([start, end]) => {
+        const a = pointAt(start), b = pointAt(end), from = client(a), to = client(b);
+        return { a, b, from, to, samples: Array.from({ length: 13 }, (_, i) => ({
+          x: from.x + (to.x - from.x) * i / 12, y: from.y + (to.y - from.y) * i / 12 })) };
+      });
+      const samples = segments.flatMap(line => line.samples);
+      // A closed-room witness must not surround an existing room or wall.
+      // Conservative client AABBs reject the entire filled rectangle, not only
+      // sampled boundary points. The default segment/X journeys are unchanged.
+      if (clearInterior) {
+        const area = { left: Math.min(...samples.map(p => p.x)), right: Math.max(...samples.map(p => p.x)),
+          top: Math.min(...samples.map(p => p.y)), bottom: Math.max(...samples.map(p => p.y)) };
+        if (occupied.some(rect => rect.left <= area.right + 12 && rect.right >= area.left - 12
+          && rect.top <= area.bottom + 12 && rect.bottom >= area.top - 12)) continue;
+      }
+      if (samples.every(available)) return { ...segments[0], segments, clip, samples };
+    }
+  }
+  throw Error('No unobscured snapped segment fits the actual visible canvas; native migration was not attempted');
+}
